<ContentDialog
    x:Class="BetterProgressBar.Demo.IndeterminateProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:ZipGenius.BetterProgressBar"
    Title="Indeterminate progress"
    CloseButtonText="Close">

    <StackPanel Spacing="12">
        <TextBlock Text="Both progress bars are running in indeterminate mode."
                   TextWrapping="Wrap" />
        <ctrl:BetterProgressBar Theme="Windows11"
                                ProgressState="Indeterminate"
                                HorizontalAlignment="Stretch" />
        <ProgressBar IsIndeterminate="True"
                     HorizontalAlignment="Stretch" />
    </StackPanel>
</ContentDialog>
